[app]
title = Brawl Stars Bot
package.name = brawlstarsbot
package.domain = com.brawlstarsbot
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0.0
requirements = python3,kivy,opencv-python-headless,pillow,adbutils
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,WRITE_EXTERNAL_STORAGE,READ_EXTERNAL_STORAGE
android.api = 31
android.minapi = 24
android.ndk = 25b
android.arch = arm64-v8a
